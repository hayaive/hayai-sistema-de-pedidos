# ── HAYAI Mostrador · lo que hace falta del lado del servidor ──────
#
# En Vercel esto NO es un archivo: son dos variables de entorno, en
# Settings → Environment Variables. Este archivo está aquí para decir
# cuáles son y para poder levantarlo en la máquina de uno (copiándolo
# a .env.local, que git ya ignora).

# La base de datos. Sale de Neon: Vercel → Storage → Neon → Connect,
# y se copia la cadena que dice "pooled".
DATABASE_URL="postgres://usuario:clave@ep-lo-que-sea.neon.tech/neondb?sslmode=require"

# El cerrojo de /api. Tiene que ser EXACTAMENTE la misma cadena que
# LLAVE_API dentro de public/prototipo.html, o el mostrador no podrá
# sincronizar. Para inventarse una:
#     node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HAYAI_TOKEN="cambia-esto-por-una-cadena-larga-y-al-azar"
